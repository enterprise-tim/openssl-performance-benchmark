{
  "name": "openssl-performance-benchmark",
  "version": "1.0.17-dev.0",
  "type": "module",
  "scripts": {
    "benchmark": "node scripts/run-benchmark.js",
    "aggregate": "node scripts/aggregate-results.js downloaded-results results",
    "aggregate:local": "node scripts/aggregate-results.js results results",
    "generate-report": "node scripts/generate-report.js",
    "generate-viz": "node scripts/generate-viz-multipage.js",
    "generate-viz:single": "node scripts/generate-viz.js",
    "report": "npm run generate-report && npm run generate-viz",
    "report:regen": "bash scripts/regenerate-from-local.sh",
    "test": "vitest run",
    "test:node": "node tests/run-all-tests.js",
    "test:unit": "vitest run tests/*.test.js",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:viz": "vitest run tests/visualizations.test.js",
    "test:viz:watch": "vitest watch tests/visualizations.test.js",
    "test:legacy": "bash ./test_jq.sh",
    "test:docker": "bash scripts/test-docker-build.sh quick",
    "test:docker:full": "bash scripts/test-docker-build.sh full",
    "test:docker:version": "bash scripts/test-docker-build.sh quick",
    "test:mlkem-hypothesis": "bash scripts/test-mlkem-hypothesis.sh",
    "lint:yaml": "bash scripts/lint-yaml.sh",
    "lint:workflows": "bash scripts/test-workflow-bash.sh",
    "lint:actions": "bash scripts/lint-actions.sh",
    "validate": "npm test && npm run test:docker",
    "validate:full": "npm run test:coverage && npm run test:docker:full",
    "pretest": "echo '🧪 Running test suite with Vitest...'",
    "prepublishOnly": "npm test",
    "precommit": "npm run lint:actions && npm test"
  },
  "devDependencies": {
    "vitest": "^4.1.8",
    "jsdom": "^23.0.0",
    "@vitest/ui": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "d3": "^7.8.5"
  },
  "dependencies": {}
}
